{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanloom.local/contracts/capability-descriptor/0.2",
  "title": "CapabilityDescriptor (M0 draft v0.2)",
  "description": "草案骨架 v0.2：字段名对齐能力契约 3.2 字段表与 3.3 完整示例（v0.1 曾偏离示例，已更正）。约束取自 3.1、3.4、3.5。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "capabilityId",
    "contractVersion",
    "ownerModule",
    "publicationState",
    "operationKind",
    "impactLevel",
    "effectModel",
    "inputSchema",
    "outputSchema",
    "authorization",
    "execution",
    "idempotency",
    "confirmation",
    "resultVerification",
    "modelDelivery",
    "bindings",
    "implementationRef",
    "compatibility"
  ],
  "properties": {
    "capabilityId": {
      "type": "string",
      "pattern": "^titanloom\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*\\.[a-z][a-z0-9_]*$"
    },
    "contractVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "ownerModule": {
      "type": "string",
      "minLength": 1
    },
    "ownerTeamRef": {
      "type": "string"
    },
    "titleKey": {
      "type": "string"
    },
    "descriptionKey": {
      "type": "string"
    },
    "publicationState": {
      "enum": [
        "draft",
        "active",
        "deprecated",
        "disabled",
        "retired"
      ]
    },
    "operationKind": {
      "enum": [
        "read",
        "draft_write",
        "business_write",
        "control"
      ]
    },
    "impactLevel": {
      "enum": [
        "low",
        "medium",
        "high"
      ]
    },
    "effectModel": {
      "enum": [
        "none",
        "atomic",
        "staged_publish",
        "external"
      ]
    },
    "inputSchema": {
      "type": "object",
      "required": [
        "ref",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^schema:[a-z0-9_.]+:\\d+\\.\\d+\\.\\d+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "平台登记的 JSON Schema 引用及摘要（规范 3.2）；不接受任意远程 URL，依赖在注册时解析并打包"
    },
    "outputSchema": {
      "type": "object",
      "required": [
        "ref",
        "digest"
      ],
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string",
          "pattern": "^schema:[a-z0-9_.]+:\\d+\\.\\d+\\.\\d+$"
        },
        "digest": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "description": "平台登记的 JSON Schema 引用及摘要（规范 3.2）；不接受任意远程 URL，依赖在注册时解析并打包"
    },
    "resourceRequirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "targetTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "inputTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outputTypes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dependencyResolver": {
          "type": "string"
        }
      }
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "agentPolicies",
        "delegationRequiredForAgent"
      ],
      "properties": {
        "action": {
          "type": "string"
        },
        "agentPolicies": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "deny",
              "draft_only",
              "confirm",
              "allow"
            ]
          },
          "description": "能力支持的策略子集，不表示已授予"
        },
        "delegationRequiredForAgent": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "budgetClass",
        "cancellation",
        "retryPolicy"
      ],
      "properties": {
        "mode": {
          "enum": [
            "sync",
            "async",
            "adaptive"
          ]
        },
        "timeoutSeconds": {
          "type": "integer",
          "minimum": 1
        },
        "budgetClass": {
          "type": "string"
        },
        "queueDeadlineSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "cancellation": {
          "type": "string"
        },
        "retryPolicy": {
          "type": "string"
        }
      }
    },
    "idempotency": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "required"
      ],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "scope": {
          "type": "string"
        },
        "retentionProfile": {
          "type": "string"
        },
        "businessDedupRule": {
          "type": "string"
        }
      }
    },
    "confirmation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "supportsPreview"
      ],
      "properties": {
        "supportsPreview": {
          "type": "boolean"
        },
        "requiredWhen": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "resultVerification": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "validatorRef",
        "evidence"
      ],
      "properties": {
        "validatorRef": {
          "type": "string"
        },
        "validatorVersion": {
          "type": "string"
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "成功证据字段；不能只有自然语言结果"
        }
      }
    },
    "modelDelivery": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "defaultProjection"
      ],
      "properties": {
        "defaultProjection": {
          "type": "string"
        },
        "allowedClasses": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "maxOutputBytes": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "bindings": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "http": {
          "type": "string"
        },
        "sdk": {
          "type": "string"
        },
        "cli": {
          "type": "string"
        }
      },
      "minProperties": 1,
      "description": "受控映射，不包含调用者可任意替换的执行入口"
    },
    "implementationRef": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*:[A-Za-z0-9_.-]+:\\d+\\.\\d+\\.\\d+$",
      "description": "精确实现 / 插件版本，如 builtin:data.pipeline.run:1.0.0；摘要见 implementationDigest"
    },
    "implementationDigest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hostContract"
      ],
      "properties": {
        "hostContract": {
          "type": "string"
        },
        "sdkRange": {
          "type": "string"
        },
        "deprecatedAfter": {
          "type": "string"
        },
        "migrationNote": {
          "type": "string"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "operationKind": {
            "const": "business_write"
          }
        },
        "required": [
          "operationKind"
        ]
      },
      "then": {
        "properties": {
          "idempotency": {
            "properties": {
              "required": {
                "const": true
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "authorization": {
            "properties": {
              "agentPolicies": {
                "contains": {
                  "const": "draft_only"
                }
              }
            },
            "required": [
              "agentPolicies"
            ]
          }
        },
        "required": [
          "authorization"
        ]
      },
      "then": {
        "properties": {
          "operationKind": {
            "enum": [
              "draft_write"
            ]
          }
        }
      }
    }
  ]
}
