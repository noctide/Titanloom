{
  "_note": "M0 草案。来源：能力契约 6.5（命令）、8.3（JobRun）。终态不复活。",
  "command": {
    "initial": ["prepared","awaiting_confirmation","ready"],
    "transitions": {
      "prepared": ["awaiting_confirmation","ready","canceled","expired"],
      "awaiting_confirmation": ["ready","canceled","expired"],
      "ready": ["accepted","canceled","expired"],
      "accepted": [], "canceled": [], "expired": []
    },
    "terminal": ["accepted","canceled","expired"]
  },
  "jobRun": {
    "initial": ["queued"],
    "transitions": {
      "queued": ["running","canceled","timed_out","failed"],
      "running": ["succeeded","failed","retry_wait","cancel_requested","reconciling","timed_out"],
      "retry_wait": ["queued","canceled","timed_out","failed"],
      "cancel_requested": ["canceled","succeeded","failed","reconciling","timed_out"],
      "reconciling": ["succeeded","failed","canceled","retry_wait","timed_out"],
      "succeeded": [], "failed": [], "canceled": [], "timed_out": []
    },
    "terminal": ["succeeded","failed","canceled","timed_out"]
  }
}
