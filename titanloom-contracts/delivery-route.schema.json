{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanloom.local/contracts/delivery-route/0.1",
  "title": "DeliveryRoute (M0 draft)",
  "description": "来源：集成与消息通道子方案 3.1。模板变量级别不得高于通道上限（跨对象规则由发布校验器执行，测试中提供参考实现）。 修订生命周期（revisionState）、激活（见 config-activation）与运行开关（operationalState）是三个独立维度，不用单一 state 承载。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "routeId",
    "revision",
    "sources",
    "channelIds",
    "templateVersionRef",
    "dedupeKeyTemplate",
    "revisionState",
    "operationalState"
  ],
  "properties": {
    "routeId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "category"
        ],
        "properties": {
          "category": {
            "type": "string"
          },
          "minSeverity": {
            "enum": [
              "info",
              "warning",
              "critical"
            ]
          },
          "scopeRef": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "channelIds": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "templateVersionRef": {
      "type": "string"
    },
    "dedupeKeyTemplate": {
      "type": "string",
      "minLength": 1
    },
    "aggregateWindowSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "revisionState": {
      "enum": [
        "draft",
        "validated",
        "published",
        "superseded",
        "withdrawn"
      ],
      "description": "ConfigRevision 生命周期（后台治理 7.2）；published 后内容不可变"
    },
    "operationalState": {
      "enum": [
        "enabled",
        "paused",
        "disabled"
      ],
      "description": "运行开关：与修订发布、激活分离；paused / disabled 可立即生效（紧急禁用，后台治理 7.4）"
    }
  }
}
