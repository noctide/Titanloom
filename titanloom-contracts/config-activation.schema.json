{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanloom.local/contracts/config-activation/0.1",
  "title": "ConfigActivation (M0 draft)",
  "description": "来源：后台治理 7.2、7.3。修订发布不代表所有目标已应用；记录每个目标已应用的版本、失败和重试时间；安全收紧不因节点未确认而回退为旧的宽权限。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "activationId",
    "configType",
    "configId",
    "targetRevision",
    "state",
    "targets",
    "createdAt"
  ],
  "properties": {
    "activationId": {
      "type": "string"
    },
    "configType": {
      "type": "string"
    },
    "configId": {
      "type": "string"
    },
    "targetRevision": {
      "type": "integer",
      "minimum": 1
    },
    "previousRevision": {
      "type": "integer",
      "minimum": 1
    },
    "state": {
      "enum": [
        "pending",
        "applying",
        "effective",
        "partial",
        "failed"
      ]
    },
    "securityTightening": {
      "type": "boolean",
      "description": "true 表示该变更收紧权限或安全策略"
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "targetRef",
          "appliedRevision",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "targetRef": {
            "type": "string"
          },
          "appliedRevision": {
            "type": [
              "integer",
              "null"
            ],
            "minimum": 1
          },
          "state": {
            "enum": [
              "pending",
              "applied",
              "failed"
            ]
          },
          "lastError": {
            "type": "string"
          },
          "nextRetryAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "finishedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "const": "effective"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "properties": {
          "targets": {
            "items": {
              "properties": {
                "state": {
                  "const": "applied"
                }
              }
            }
          }
        },
        "required": [
          "finishedAt"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "partial"
          }
        },
        "required": [
          "state"
        ]
      },
      "then": {
        "required": [
          "finishedAt"
        ]
      }
    }
  ]
}
