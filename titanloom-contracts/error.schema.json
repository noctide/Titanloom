{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanloom.local/contracts/error/0.1",
  "title": "ErrorResponse (M0 draft)",
  "description": "草案骨架。来源：能力契约 12.1。details 按错误码另定 Schema，只含当前主体有权看到的信息；不得返回栈、SQL、路径、凭据。",
  "type": "object",
  "required": [
    "requestId",
    "error"
  ],
  "additionalProperties": false,
  "properties": {
    "requestId": {
      "type": "string"
    },
    "error": {
      "$ref": "#/$defs/errorBody"
    }
  },
  "$defs": {
    "errorBody": {
      "type": "object",
      "required": [
        "code",
        "messageKey",
        "retryable"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]*$"
        },
        "messageKey": {
          "type": "string",
          "pattern": "^errors:[a-z][A-Za-z0-9]*$"
        },
        "messageParams": {
          "type": "object"
        },
        "retryable": {
          "type": "boolean"
        },
        "recoveryAction": {
          "type": "string"
        },
        "details": {
          "type": "object"
        }
      }
    }
  }
}
