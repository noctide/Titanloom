{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanloom.local/contracts/composition-version/0.1",
  "title": "CompositionVersion（组合版本）",
  "description": "来源：后端详细设计·插件宿主 · Shell · 平台管理（M1）A、B；插件与扩展体系 6.2。每次启用 / 停用生成新版本，记录原因与上一版，可回退；core 插件必须在且为 active。",
  "type": "object",
  "required": [
    "version",
    "createdBy",
    "createdAt",
    "reason",
    "plugins"
  ],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "previous": {
      "type": "integer",
      "minimum": 1
    },
    "createdBy": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "version",
          "kind",
          "state"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
          },
          "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+$"
          },
          "kind": {
            "enum": [
              "core",
              "domain",
              "shell",
              "admin",
              "integration",
              "skin"
            ]
          },
          "state": {
            "enum": [
              "active",
              "disabled"
            ]
          }
        },
        "if": {
          "properties": {
            "kind": {
              "const": "core"
            }
          }
        },
        "then": {
          "properties": {
            "state": {
              "const": "active"
            }
          }
        }
      }
    }
  },
  "if": {
    "properties": {
      "version": {
        "minimum": 2
      }
    }
  },
  "then": {
    "required": [
      "previous"
    ]
  }
}
