{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanloom.local/contracts/inbound-endpoint/0.1",
  "title": "InboundEndpoint (M0 draft)",
  "description": "来源：集成与消息通道子方案 4。不可猜测的路径标识不是鉴权；必须有签名或共享密钥、时间窗、体积与限流。 修订生命周期（revisionState）、激活（见 config-activation）与运行开关（operationalState）是三个独立维度，不用单一 state 承载。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "endpointId",
    "revision",
    "pathId",
    "purpose",
    "auth",
    "timestampToleranceSeconds",
    "maxBodyBytes",
    "rateLimit",
    "revisionState",
    "operationalState"
  ],
  "properties": {
    "endpointId": {
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "pathId": {
      "type": "string",
      "minLength": 22,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "purpose": {
      "enum": [
        "event_ingest",
        "command",
        "conversation"
      ]
    },
    "auth": {
      "type": "object",
      "required": [
        "scheme",
        "secretRef"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "hmac_sha256",
            "shared_secret_header"
          ]
        },
        "secretRef": {
          "type": "string",
          "pattern": "^secret:[A-Za-z0-9_./-]+$"
        },
        "previousSecretRef": {
          "type": "string",
          "pattern": "^secret:[A-Za-z0-9_./-]+$"
        },
        "overlapUntil": {
          "type": "string",
          "format": "date-time"
        }
      },
      "additionalProperties": false
    },
    "timestampToleranceSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 900
    },
    "replayRetentionSeconds": {
      "type": "integer",
      "minimum": 60
    },
    "maxBodyBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1048576
    },
    "rateLimit": {
      "type": "object",
      "required": [
        "perMinute"
      ],
      "properties": {
        "perMinute": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "payloadSchemaRef": {
      "type": "string"
    },
    "identityBindingRequired": {
      "type": "boolean"
    },
    "targetRef": {
      "type": "string"
    },
    "revisionState": {
      "enum": [
        "draft",
        "validated",
        "published",
        "superseded",
        "withdrawn"
      ],
      "description": "ConfigRevision 生命周期（后台治理 7.2）；published 后内容不可变"
    },
    "operationalState": {
      "enum": [
        "enabled",
        "paused",
        "disabled"
      ],
      "description": "运行开关：与修订发布、激活分离；paused / disabled 可立即生效（紧急禁用，后台治理 7.4）"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "purpose": {
            "enum": [
              "command",
              "conversation"
            ]
          }
        },
        "required": [
          "purpose"
        ]
      },
      "then": {
        "required": [
          "identityBindingRequired"
        ],
        "properties": {
          "identityBindingRequired": {
            "const": true
          }
        },
        "description": "命令与对话必须绑定发送者身份"
      }
    },
    {
      "if": {
        "required": [
          "auth"
        ],
        "properties": {
          "auth": {
            "required": [
              "previousSecretRef"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "auth": {
            "required": [
              "overlapUntil"
            ]
          }
        }
      }
    }
  ]
}
