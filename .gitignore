# Titanloom .gitignore

# --- 密钥与本地环境（绝不提交）---
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
.private/
wordlist.private.txt

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
dist/
build/

# --- Node / 前端 ---
node_modules/
.pnpm-store/
.next/
.nuxt/
out/
*.tsbuildinfo

# --- 编辑器与操作系统 ---
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db
desktop.ini

# --- 日志与临时文件 ---
*.log
*.tmp
tmp/
